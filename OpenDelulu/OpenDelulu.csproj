<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared Avalonia UI used by every platform head (Desktop, Android, iOS). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="Silk.NET.Direct3D11" />
    <PackageReference Include="Silk.NET.DXGI" />
  </ItemGroup>

  <ItemGroup>
    <!-- SPIR-V compiled from the .vert/.frag sources by tools/OpenDelulu.ShaderCompiler -->
    <EmbeddedResource Include="Rendering\Vulkan\Shaders\*.spv" LogicalName="OpenDelulu.Shaders.%(Filename)%(Extension)" />
    <None Include="Rendering\Vulkan\Shaders\*.vert;Rendering\Vulkan\Shaders\*.frag" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenDelulu.Engine\OpenDelulu.Engine.csproj" />
  </ItemGroup>
</Project>
