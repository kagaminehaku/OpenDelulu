<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenDelulu.ViewModels"
             x:Class="OpenDelulu.Views.OilActionsView"
             x:DataType="vm:PlayViewModel">
    <!-- The touch actions of a special area: the original buttons (st00_01_*) in a column on the right of 1024x768. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="1024" Height="768">
            <ItemsControl ItemsSource="{Binding OilActions}" Width="1024" Height="768">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ContentPresenter" x:DataType="vm:OilActionChoice">
                        <Setter Property="Canvas.Left" Value="760" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OilActionChoice">
                        <Panel Width="232" Height="56" Background="Transparent" Cursor="Hand" PointerPressed="OnActionPressed">
                            <Image Source="{Binding Image}" />
                            <Border Background="#E0E060A0" CornerRadius="20"
                                    IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}">
                                <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Image Source="{Binding MapCancel}" Canvas.Left="820" Canvas.Top="704" Width="112" Height="48" Cursor="Hand"
                   PointerPressed="OnCancelPressed" />
        </Canvas>
    </Viewbox>
</UserControl>
