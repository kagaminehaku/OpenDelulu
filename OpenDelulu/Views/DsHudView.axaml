<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenDelulu.ViewModels"
             x:Class="OpenDelulu.Views.DsHudView"
             x:DataType="vm:DsHud">
    <!-- An original in-game menu (ds01_NN) over the 3D view, in 1024x768 like the other overlays. Only the quads take
         the pointer, so rubbing and turning the camera work everywhere else. -->
    <Viewbox Stretch="Uniform">
        <ItemsControl x:Name="Quads" ItemsSource="{Binding Quads}" Width="1024" Height="768" ClipToBounds="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="vm:HudQuad">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HudQuad">
                    <Panel Width="{Binding W}" Height="{Binding H}" IsVisible="{Binding IsVisible}"
                           Background="Transparent" IsHitTestVisible="{Binding IsHitTestable}" Cursor="Hand"
                           PointerEntered="OnQuadEntered" PointerExited="OnQuadExited" PointerPressed="OnQuadPressed"
                           PointerMoved="OnQuadMoved" PointerReleased="OnQuadReleased">
                        <Image Source="{Binding Image}" Stretch="Fill" />
                        <Image Source="{Binding HoverImage}" Stretch="Fill" Opacity="{Binding HoverOpacity}" />
                    </Panel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Viewbox>
</UserControl>
