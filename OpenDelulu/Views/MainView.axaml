<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenDelulu.ViewModels"
             xmlns:r="using:OpenDelulu.Rendering"
             xmlns:ch="using:OpenDelulu.Engine.Characters"
             xmlns:anim="using:OpenDelulu.Engine.Animation"
             xmlns:script="using:OpenDelulu.Engine.Script"
             xmlns:l="using:OpenDelulu.Localization"
             xmlns:v="using:OpenDelulu.Views"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="OpenDelulu.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <FontFamily x:Key="MonoFont">Consolas, Menlo, monospace</FontFamily>
    </UserControl.Resources>

    <!-- Preview templates shared by the data browser and the character maker. -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:TextPreviewViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="l:LocalizedText">
            <TextBlock Text="{Binding Text}" />
        </DataTemplate>
        <DataTemplate DataType="l:LanguageInfo">
            <TextBlock Text="{Binding Name}" />
        </DataTemplate>
        <DataTemplate DataType="vm:DialogueViewModel">
            <!-- Dialogue over the 3D view, laid out like the original's 1024x232 bottom bar (60_adv): portrait 0..192,
                 the window st06_01_02 with its name tab 192..1024 (st06_01_01 across the whole width without a speaker).
                 Choices are blue st06_01_04 buttons above it. -->
            <StackPanel IsVisible="{Binding IsVisible}" VerticalAlignment="Bottom" Spacing="2">
                <ScrollViewer MaxHeight="260" IsVisible="{Binding HasChoices}" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Choices}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChoiceOption">
                                <Button Content="{Binding Text}" Margin="4" Padding="24,8" MinWidth="220" Foreground="White"
                                        FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Center"
                                        Background="{Binding $parent[ItemsControl].((vm:DialogueViewModel)DataContext).ChoiceBackground}"
                                        Command="{Binding $parent[ItemsControl].((vm:DialogueViewModel)DataContext).ChooseCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Viewbox Stretch="Uniform" MaxHeight="240">
                    <Grid Width="1024" Height="232">
                        <Image Source="{Binding Portrait}" Width="192" Height="232" HorizontalAlignment="Left" />
                        <Border Margin="{Binding FrameMargin}" Background="{Binding Frame}" Opacity="{Binding Config.MenuOpacity, Converter={x:Static vm:MapConverters.Percent}}" />
                        <TextBlock Text="{Binding Speaker}" FontWeight="Bold" FontSize="20" Foreground="#FF4A3000"
                                   Margin="200,58,0,0" Width="143" TextAlignment="Center" HorizontalAlignment="Left"
                                   VerticalAlignment="Top" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Speaker, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding Text}" Margin="{Binding TextMargin}" TextWrapping="Wrap" FontSize="22"
                                   Foreground="White" FontWeight="SemiBold">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="3" OffsetX="1" OffsetY="1" Color="#C0002040" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,52,24"
                                Command="{Binding NextCommand}" IsVisible="{Binding CanAdvance}"
                                Background="Transparent" BorderThickness="0" Padding="4" ToolTip.Tip="{l:Tr dialogue.next}">
                            <Panel>
                                <Image Source="{Binding NextIcon}" Width="32" Height="32"
                                       IsVisible="{Binding NextIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{l:Tr dialogue.next}" Foreground="White" FontSize="20"
                                           IsVisible="{Binding NextIcon, Converter={x:Static ObjectConverters.IsNull}}" />
                            </Panel>
                        </Button>
                    </Grid>
                </Viewbox>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:AudioPreviewViewModel">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:Tr audio.play}" Classes="accent" Command="{Binding PlayCommand}" />
                    <Button Content="{l:Tr audio.stop}" Command="{Binding StopCommand}" />
                    <CheckBox Content="{l:Tr audio.loop}" IsChecked="{Binding Loop}" />
                </StackPanel>
                <TextBlock Text="{Binding LipSyncLabel}" IsVisible="{Binding HasLipSync}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Device}" Opacity="0.6" FontSize="12" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:ImagePreviewViewModel">
            <Border Background="#30808080" CornerRadius="4">
                <Image Source="{Binding Bitmap}" Stretch="Uniform" StretchDirection="DownOnly" />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:ModelPreviewViewModel">
            <Grid RowDefinitions="*,Auto">
                <r:ModelViewer Scene="{Binding Scene}" KeepCamera="True" />
                <Expander Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                          Header="{Binding MeshesHeader}">
                    <ListBox ItemsSource="{Binding Meshes}" MaxHeight="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MeshToggleViewModel">
                                <CheckBox IsChecked="{Binding IsVisible}" Content="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,*">
        <!-- Game folder bar -->
        <Border Grid.Row="0" Padding="12,10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding GameFolder}" PlaceholderText="{l:Tr top.folderPlaceholder}" />
                    <Button Grid.Column="1" Content="{l:Tr top.browse}" Command="{Binding BrowseCommand}" />
                    <Button Grid.Column="2" Content="{l:Tr top.open}" Classes="accent" Command="{Binding LoadCommand}" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding Backends}" SelectedIndex="{Binding SelectedBackendIndex}" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                              ToolTip.Tip="{l:Tr top.language}" />
                    <Button Grid.Column="5" Content="{l:Tr settings.button}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="4">
                                    <Button Content="{l:Tr settings.config}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" Command="{Binding OpenConfigCommand}"
                                            IsEnabled="{Binding Config.HasOriginal, FallbackValue=False}" />
                                    <TextBlock Text="{l:Tr settings.sound}" FontWeight="SemiBold" />
                                    <TextBlock Text="{l:Tr settings.master}" Opacity="0.7" />
                                    <Slider Minimum="0" Maximum="100" Value="{Binding MasterVolume}" />
                                    <TextBlock Text="{l:Tr settings.music}" Opacity="0.7" />
                                    <Slider Minimum="0" Maximum="100" Value="{Binding MusicVolume}" />
                                    <TextBlock Text="{l:Tr settings.ambient}" Opacity="0.7" />
                                    <Slider Minimum="0" Maximum="100" Value="{Binding AmbientVolume}" />
                                    <TextBlock Text="{l:Tr settings.effects}" Opacity="0.7" />
                                    <Slider Minimum="0" Maximum="100" Value="{Binding EffectsVolume}" />
                                    <TextBlock Text="{l:Tr settings.voice}" Opacity="0.7" />
                                    <Slider Minimum="0" Maximum="100" Value="{Binding VoiceVolume}" />
                                    <CheckBox Content="{l:Tr settings.mute}" IsChecked="{Binding IsMuted}" />
                                    <TextBlock Text="{l:Tr settings.keys}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock Text="{l:Tr settings.keyList}" TextWrapping="Wrap" Opacity="0.8" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.85" />
                    <ProgressBar Grid.Column="1" Width="120" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                </Grid>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Padding="0">
            <TabItem Header="{l:Tr tab.play}" IsEnabled="{Binding Play, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="300,*" DataContext="{Binding Play}" x:DataType="vm:PlayViewModel">
                    <StackPanel Margin="12" Spacing="8">
                        <StackPanel Spacing="8" IsEnabled="{Binding !InGame}" IsVisible="{Binding !HasOriginalMap}">
                            <TextBlock Text="{l:Tr play.girl}" Opacity="0.7" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Girls}" SelectedItem="{Binding SelectedGirl}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GirlChoice">
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{l:Tr play.stage}" Opacity="0.7" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding StageNames}" SelectedIndex="{Binding SelectedStageIndex}" />
                            <TextBlock Text="{l:Tr play.time}" Opacity="0.7" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Times}" SelectedIndex="{Binding SelectedTimeIndex}" />
                            <Button Content="{l:Tr play.enter}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding EnterCommand}" />
                        </StackPanel>
                        <Button Content="{l:Tr play.leave}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding RequestLeaveCommand}" IsVisible="{Binding InGame}" />
                        <Button Content="{l:Tr play.showMenu}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding ToggleHudCommand}" IsVisible="{Binding IsHudClosed}" />
                        <Button Content="{l:Tr play.toLobby}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding BackToLobbyCommand}" IsVisible="{Binding ShowMap}" />
                        <Button Content="{l:Tr play.album}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding OpenAlbumCommand}" IsVisible="{Binding !InGame}"
                                IsEnabled="{Binding HasOriginalAlbum}" />
                        <Button Content="{l:Tr play.photo}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding OpenPhotoSelectCommand}" IsVisible="{Binding !InGame}"
                                IsEnabled="{Binding HasPhotoMode}" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock Text="{Binding Dialogue.Status}" TextWrapping="Wrap" Foreground="OrangeRed" />
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="8">
                        <r:ModelViewer Scene="{Binding Scene}" DefaultZoom="0.6" TouchHandler="{Binding TouchHandler}" />
                        <v:StatusView IsVisible="{Binding InGame}" />
                        <v:PhotoView IsVisible="{Binding IsPhotoMenuVisible}" />
                        <v:LobbyView IsVisible="{Binding IsLobbyVisible}" />
                        <ContentControl Content="{Binding Dialogue}" VerticalAlignment="Bottom" />
                        <v:MapScreenView IsVisible="{Binding ShowMap}" />
                        <v:TitleView IsVisible="{Binding IsTitleVisible}" />
                        <v:TicketView IsVisible="{Binding IsTicketVisible}" />
                        <v:MemoryView IsVisible="{Binding IsMemoryOpen}" />
                        <v:AlbumView IsVisible="{Binding IsAlbumOpen}" />
                        <Panel IsVisible="{Binding DateHud.IsVisible, FallbackValue=False}">
                            <v:DsHudView DataContext="{Binding DateHud}" />
                        </Panel>
                        <Panel IsVisible="{Binding SystemHud.IsVisible, FallbackValue=False}">
                            <v:DsHudView DataContext="{Binding SystemHud}" />
                        </Panel>
                        <!-- Pointing at the top edge slides the system menu bar in. -->
                        <Border Height="6" VerticalAlignment="Top" Background="Transparent"
                                IsVisible="{Binding SystemHud.IsVisible, FallbackValue=False}" PointerEntered="OnTopEdgeEntered" />
                        <Panel IsVisible="{Binding CameraHud.IsVisible, FallbackValue=False}">
                            <v:DsHudView DataContext="{Binding CameraHud}" />
                        </Panel>
                        <Panel IsVisible="{Binding OilHud.IsVisible, FallbackValue=False}">
                            <v:DsHudView DataContext="{Binding OilHud}" />
                        </Panel>
                        <Panel IsVisible="{Binding HHud.IsVisible, FallbackValue=False}">
                            <v:DsHudView DataContext="{Binding HHud}" />
                        </Panel>
                        <v:OilActionsView IsVisible="{Binding IsChoosingAction}" />
                        <v:WardrobeView IsVisible="{Binding IsWardrobeOpen}" />
                        <v:ConfirmView IsVisible="{Binding IsConfirming}" />
                        <!-- The game's movies (stage introductions): click to skip. -->
                        <Border Background="Black" IsVisible="{Binding IsMoviePlaying}" PointerPressed="OnMoviePressed">
                            <Image Source="{Binding MovieFrame}" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{l:Tr tab.characters}" IsEnabled="{Binding Characters, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid x:Name="CharacterBody" ColumnDefinitions="300,*" DataContext="{Binding Characters}" x:DataType="vm:CharacterViewModel">
                    <ScrollViewer Grid.Column="0">
                    <StackPanel x:Name="CharacterOptions" Margin="12" Spacing="8">
                        <TextBlock Text="{l:Tr char.girl}" Opacity="0.7" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Girls}" SelectedItem="{Binding SelectedGirl}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ch:GirlInfo">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{l:Tr char.hair}" Opacity="0.7" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Hairs}" SelectedIndex="{Binding SelectedHairIndex}" />
                        <TextBlock Text="{l:Tr char.swimsuit}" Opacity="0.7" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Swimsuits}" SelectedItem="{Binding SelectedSwimsuit}"
                                  MaxDropDownHeight="420">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ch:SwimsuitInfo">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="{Binding Row}" Opacity="0.5" MinWidth="32" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{l:Tr char.cut}" Opacity="0.7" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Cuts}" SelectedIndex="{Binding SelectedCutIndex}" />

                        <Separator Margin="0,4" />
                        <TextBlock Text="{l:Tr char.animation}" Opacity="0.7" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Animations}" SelectedItem="{Binding SelectedAnimation}"
                                  MaxDropDownHeight="420">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ch:AssetRef">
                                    <TextBlock Text="{Binding File}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip}"
                                  MaxDropDownHeight="420">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="anim:AnimationClipInfo">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <WrapPanel>
                            <ToggleButton IsChecked="{Binding IsPlaying}" Content="{l:Tr char.playing}" Margin="0,0,8,0" />
                            <CheckBox IsChecked="{Binding FollowNext}" Content="{l:Tr char.followNext}" />
                        </WrapPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{l:Tr char.speed}" VerticalAlignment="Center" Opacity="0.7" />
                            <Slider Grid.Column="1" Minimum="0.1" Maximum="3" Value="{Binding Speed}" />
                            <TextBlock Grid.Column="2" Text="{Binding Speed, StringFormat='{}{0:0.0}x'}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{l:Tr char.expression}" Opacity="0.7" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Expressions}" SelectedItem="{Binding SelectedExpression}"
                                  MaxDropDownHeight="420" />
                        <CheckBox IsChecked="{Binding AutoBlink}" Content="{l:Tr char.autoBlink}" />
                        <CheckBox IsChecked="{Binding EyesFollowCamera}" Content="{l:Tr char.eyesFollow}" />

                        <TextBlock Text="{l:Tr char.voice}" Opacity="0.7" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding VoiceGroups}" SelectedIndex="{Binding SelectedVoiceGroupIndex}" />
                            <Button Grid.Column="1" Content="{l:Tr char.speak}" Command="{Binding SpeakCommand}" />
                            <Button Grid.Column="2" Content="{l:Tr char.stopVoice}" Command="{Binding StopVoiceCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding VoiceInfo}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />

                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="OrangeRed" />
                        <TextBlock Text="{Binding TableInfo}" TextWrapping="Wrap" Opacity="0.5" FontSize="12" />
                    </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="CharacterPreview" Grid.Column="1" RowDefinitions="Auto,*" Margin="8">
                        <StackPanel Margin="4,0,4,8">
                            <TextBlock Text="{Binding Preview.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Preview.Details}" Opacity="0.7" />
                        </StackPanel>
                        <ContentControl Grid.Row="1" Content="{Binding Preview}" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{l:Tr tab.scripts}" IsEnabled="{Binding Scripts, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="300,*" DataContext="{Binding Scripts}" x:DataType="vm:ScriptViewModel">
                    <StackPanel Margin="12" Spacing="8">
                        <TextBlock Text="{l:Tr scripts.script}" Opacity="0.7" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}"
                                  MaxDropDownHeight="480">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScriptItem">
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{l:Tr scripts.intimacy}" Opacity="0.7" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding IntimacyLevels}" SelectedIndex="{Binding IntimacyIndex}" />
                        <Button Content="{l:Tr scripts.start}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding StartCommand}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="OrangeRed" />
                        <TextBlock Text="{Binding Dialogue.Status}" TextWrapping="Wrap" Foreground="OrangeRed" />
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="8">
                        <r:ModelViewer Scene="{Binding Scene}" DefaultZoom="0.45" />
                        <ContentControl Content="{Binding Dialogue}" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{l:Tr tab.data}">
                <Grid x:Name="Body" ColumnDefinitions="340,4,*">
                    <!-- Archive + file browser -->
                    <Grid x:Name="LeftPane" Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="8">
                        <ComboBox Grid.Row="0" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Archives}" SelectedItem="{Binding SelectedArchive}"
                                  PlaceholderText="Archive (.pp)">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArchiveItem">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Display}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Edition}" Opacity="0.6" Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Row="1" Margin="0,8" Text="{Binding FileFilter}" PlaceholderText="{l:Tr data.filter}" />
                        <ListBox Grid.Row="2" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileItem">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Display}" FontFamily="{StaticResource MonoFont}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Size}" Opacity="0.6" Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns" />

                    <!-- Preview -->
                    <Grid x:Name="PreviewPane" Grid.Column="2" RowDefinitions="Auto,*" Margin="8">
                        <StackPanel Grid.Row="0" Margin="4,0,4,8" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding Preview.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Preview.Details}" Opacity="0.7" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding StorageHint}" TextWrapping="Wrap" Opacity="0.6" Margin="4"
                                   IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNull}}" />
                        <ContentControl Grid.Row="1" Content="{Binding Preview}" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- The original CONFIG screen over everything. -->
        <Panel Grid.RowSpan="2" IsVisible="{Binding Config.IsOpen, FallbackValue=False}">
            <v:ConfigView DataContext="{Binding Config}" />
        </Panel>

        <!-- Emergency screen (B / Pause): covers everything until a key or click. -->
        <Border Grid.RowSpan="2" Background="Black" IsVisible="{Binding IsEmergency}" PointerPressed="OnEmergencyPressed">
            <Image Source="{Binding EmergencyImage}" Stretch="Fill" />
        </Border>
    </Grid>
</UserControl>
