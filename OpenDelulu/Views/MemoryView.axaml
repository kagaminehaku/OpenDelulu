<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenDelulu.ViewModels"
             x:Class="OpenDelulu.Views.MemoryView"
             x:DataType="vm:PlayViewModel">
    <!-- The memory screens (56_memories) in 1024x768: Love Memory columns, the date activity list. -->
    <Panel Background="Black">
        <Viewbox Stretch="Uniform">
            <Canvas Width="1024" Height="768">
                <ItemsControl ItemsSource="{Binding MemorySprites}" Width="1024" Height="768" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:MemorySprite">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemorySprite">
                            <Image Source="{Binding Image}" Width="{Binding Width}" Height="{Binding Height}" Stretch="Fill" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Panel Width="1024" Height="768" Background="Transparent" Cursor="Hand" PointerPressed="OnPressed" />
            </Canvas>
        </Viewbox>
    </Panel>
</UserControl>
